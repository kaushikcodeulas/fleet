{
  "expo": {
    "name": "fleet",
    "slug": "fleet",
    "scheme": "fleet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "config": {
        "googleMapsApiKey": "AIzaSyBGIm2P5Vav9zkOABLCe5QIEjkhyoFpD7g"
      },
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio",
          "fetch",
          "picture-in-picture"
        ],
        "NSLocationWhenInUseUsageDescription": "Location access is required for real-time turn-by-turn fleet navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Background location access is required to keep turn-by-turn navigation and PiP active when minimized."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBGIm2P5Vav9zkOABLCe5QIEjkhyoFpD7g"
        }
      },
      "package": "com.naracoo.fleet",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-pip",
        {}
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "./plugins/withDesugaring"
    ],
    "extra": {
      "eas": {
        "projectId": "04e208fe-8acc-4255-8de6-5b4cbce845b6"
      }
    }
  }
}